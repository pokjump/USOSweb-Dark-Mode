{
  "manifest_version": 3,
  "name": "USOSweb Dark Mode",
  "version": "1.0.0",
  "description": "Ciemny motyw dla USOSweb",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["theme.js", "content-main.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content-isolated.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "USOSweb Dark Mode"
  }
}
